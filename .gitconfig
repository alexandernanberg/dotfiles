[user]
	name = Alexander Nanberg
	email = alex.nanberg@hotmail.com
	signingkey = ~/.ssh/id_ed25519.pub

# Sign commits and tags with the SSH key (the agent holds the passphrase)
[gpg]
	format = ssh

[init]
	defaultBranch = main

[core]
	editor = vim
	fsmonitor = true
	untrackedCache = true

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true
	negotiationAlgorithm = skipping

[checkout]
	workers = 0

[rebase]
	autoStash = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[commit]
	verbose = true
	gpgsign = true

[tag]
	gpgsign = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = zdiff3

# Last, so local settings override everything above
[include]
	path = ~/.gitconfig.local
