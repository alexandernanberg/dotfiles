[user]
	name = Alexander Nanberg
	email = alex.nanberg@hotmail.com

[init]
	defaultBranch = main

[core]
	editor = vim
	fsmonitor = true
	untrackedCache = true

[include]
	path = ~/.gitconfig.local

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true
	writeCommitGraph = true
	negotiationAlgorithm = skipping

[checkout]
	workers = 0

[rebase]
	autoStash = true

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[column]
	ui = auto

[commit]
	verbose = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = zdiff3
