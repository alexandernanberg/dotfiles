# Create a new git worktree and copy .env files
wt() {
  if [[ -z "$1" ]]; then
    echo "Usage: wt <branch-name> [base-branch]"
    return 1
  fi

  local repo_root
  repo_root=$(git rev-parse --show-toplevel) || return 1

  local branch="$1"
  local base="${2:-main}"
  local repo_name
  repo_name=$(basename "$repo_root")
  # Slashes in branch names would otherwise nest the worktree directory
  local worktree_path="$(dirname "$repo_root")/${repo_name}-${branch//\//-}"

  if git show-ref --quiet --verify "refs/heads/$branch"; then
    git worktree add "$worktree_path" "$branch" || return 1
  else
    git worktree add -b "$branch" "$worktree_path" "$base" || return 1
  fi

  (
    cd "$repo_root" || exit 1
    find . -name node_modules -type d -prune -o -name ".env*" -type f -print |
      while IFS= read -r env_file; do
        mkdir -p "$worktree_path/$(dirname "$env_file")"
        cp "$env_file" "$worktree_path/$(dirname "$env_file")/"
        echo "Copied: $env_file"
      done
  )

  print "\nWorktree created at: $worktree_path"
  cd "$worktree_path"
}
