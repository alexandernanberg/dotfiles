[user]
	name = Alexander Nanberg
	email = alex.nanberg@hotmail.com

[init]
	defaultBranch = main

[core]
	editor = vim

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true

[branch]
	sort = -committerdate

[diff]
	colorMoved = default

[merge]
	conflictstyle = zdiff3
