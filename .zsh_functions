# Create a new git worktree and copy .env files
wt() {
  if [[ -z "$1" ]]; then
    echo "Usage: wt <branch-name> [base-branch]"
    return 1
  fi

  local branch="$1"
  local base="$2"
  local repo_root
  repo_root=$(git rev-parse --show-toplevel) || return 1
  local repo_name="${repo_root:t}"
  local slug="${branch//\//-}"
  # Absolute, so it doesn't depend on which subdirectory wt runs from
  local worktree_path="${repo_root:h}/${repo_name}-${slug}"

  # Default to origin's default branch, then main, then master
  if [[ -z "$base" ]]; then
    base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    base="${base#origin/}"
  fi
  if [[ -z "$base" ]]; then
    if git show-ref --verify --quiet refs/heads/main; then
      base=main
    else
      base=master
    fi
  fi

  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git worktree add "$worktree_path" "$branch" || return 1
  else
    git worktree add -b "$branch" "$worktree_path" "$base" || return 1
  fi

  cd "$repo_root"
  find . -name ".env*" -type f -not -path "*/node_modules/*" -print0 |
    while IFS= read -r -d '' env_file; do
      local target_dir="$worktree_path/$(dirname "$env_file")"
      mkdir -p "$target_dir"
      cp "$env_file" "$target_dir/"
      echo "Copied: $env_file"
    done

  echo "\nWorktree created at: $worktree_path"
  cd "$worktree_path"
}
