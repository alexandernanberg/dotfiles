" Plugins
filetype plugin on
filetype indent on

" UI
syntax on
set number
set showmatch

" Encoding
set encoding=utf-8

" Update file when modified
set autoread

" Whitespace
set expandtab
set smarttab
set autoindent
set smartindent
set wrap
set tabstop=2
set shiftwidth=2
set softtabstop=2
set backspace=indent,eol,start

" Disable bells
set noerrorbells
set novisualbell

" Searching
set ignorecase
set smartcase
set hlsearch
set incsearch

" Cursor position
set ruler
set laststatus=2
